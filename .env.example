# Copy this file to .env and replace every placeholder before starting services.
POSTGRES_USER=<REPLACE_WITH_DATABASE_USERNAME>
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_DATABASE_PASSWORD>
POSTGRES_DB=<REPLACE_WITH_DATABASE_NAME>
DATABASE_URL=<REPLACE_WITH_POSTGRES_CONNECTION_URL>
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
PORT=3001
NODE_ENV=production
UPLOAD_DIR=/app/uploads

# Copy this file to backend/.env only for local non-container development.
# Replace every placeholder; do not commit the resulting file.
DATABASE_URL=<REPLACE_WITH_POSTGRES_CONNECTION_URL>
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
PORT=3001
NODE_ENV=production
UPLOAD_DIR=/app/uploads

# Company information
COMPANY_NAME=<REPLACE_WITH_COMPANY_NAME>
COMPANY_NIT=<REPLACE_WITH_COMPANY_TAX_ID>
COMPANY_ADDRESS=<REPLACE_WITH_COMPANY_ADDRESS>
COMPANY_PHONE=<REPLACE_WITH_COMPANY_PHONE>
COMPANY_EMAIL=<REPLACE_WITH_COMPANY_EMAIL>
COMPANY_CITY=<REPLACE_WITH_COMPANY_CITY>
COMPANY_WEBSITE=<REPLACE_WITH_COMPANY_WEBSITE>
COMPANY_LOGO_PATH=<REPLACE_WITH_COMPANY_LOGO_PATH>
